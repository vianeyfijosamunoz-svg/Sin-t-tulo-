v80.Activated:Connect(function()
    voidActive = not voidActive
    if voidActive then
        v80.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
        voidConn = v10.Heartbeat:Connect(function()
            if v13 and voidActive then v13.CFrame = CFrame.new(v13.Position.X + 2e15, 999999, v13.Position.Z + 2e15) end
        end)
    else
        v80.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        if voidConn then voidConn:Disconnect() voidConn = nil end
    end
    updateStatus()
end)

orbBtn.Activated:Connect(function()
    orbActive = not orbActive
    if orbActive then
        orbBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
        orbConn = v10.Heartbeat:Connect(function()
            local target = getClosest()
            if target and target.Character and orbActive then
                local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    angle = angle + 0.18
                    v13.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle)*6, 4, math.sin(angle)*6), hrp.Position)
                end
            end
        end)
    else
        orbBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        if orbConn then orbConn:Disconnect() orbConn = nil end
    end
    updateStatus()
end)

counterBtn.Activated:Connect(function()
    counterActive = not counterActive
    if counterActive then
        counterBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
        
        -- Activar Rapid Fire
        toggleTableAttribute("ShootCooldown", 0)
        toggleTableAttribute("ShootSpread", 0)
        toggleTableAttribute("ShootRecoil", 0)

        -- Activar Fast Melee
        getgenv().RivalsFastMelee = true
        cacheMeleeTables()
        pcall(function()
            for _, gcVal in ipairs(cachedMeleeTables) do
                if rawget(gcVal, "MeleeCooldown") then gcVal.MeleeCooldown = 0 end
                if rawget(gcVal, "SwingCooldown") then gcVal.SwingCooldown = 0 end
                if rawget(gcVal, "SlashCooldown") then gcVal.SlashCooldown = 0 end
                if rawget(gcVal, "AttackCooldown") then gcVal.AttackCooldown = 0 end
                if rawget(gcVal, "HitCooldown") then gcVal.HitCooldown = 0 end
            end
        end)

        -- Activar Bring All Players
        if bringConn then bringConn:Disconnect() end
        bringConn = v10.RenderStepped:Connect(function()
            pcall(function()
                if not v13 then return end
                local targetCFrame = v13.CFrame * CFrame.new(0, -2, -1)

                for _, plr in ipairs(v8:GetPlayers()) do
                    if plr ~= v11 and plr.Character then
                        local enemyHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                        if enemyHRP then
                            enemyHRP.CFrame = targetCFrame
                            enemyHRP.AssemblyLinearVelocity = Vector3.zero
                        end
                    end
                end
            end)
        end)
    else
        counterBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        
        -- Desactivar Bring All Players
        if bringConn then
            bringConn:Disconnect()
            bringConn = nil
        end
        
        -- Desactivar Rapid Fire
        toggleTableAttribute("ShootCooldown", 0.1)
        toggleTableAttribute("ShootSpread", 1)
        toggleTableAttribute("ShootRecoil", 1)

        -- Desactivar Fast Melee
        getgenv().RivalsFastMelee = false
        pcall(function()
            for _, gcVal in ipairs(cachedMeleeTables) do
                if rawget(gcVal, "MeleeCooldown") then gcVal.MeleeCooldown = 0.5 end
                if rawget(gcVal, "SwingCooldown") then gcVal.SwingCooldown = 0.5 end
                if rawget(gcVal, "SlashCooldown") then gcVal.SlashCooldown = 0.5 end
                if rawget(gcVal, "AttackCooldown") then gcVal.AttackCooldown = 0.5 end
                if rawget(gcVal, "HitCooldown") then gcVal.HitCooldown = 0.5 end
            end
        end)
    end
    updateStatus()
end)

