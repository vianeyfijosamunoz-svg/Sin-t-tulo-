-- Variables y caché para la lógica de UE COUNTER
getgenv().RivalsFastMelee = false
local cachedMeleeTables = {}
local meleeCacheInitialized = false

local function cacheMeleeTables()
    if meleeCacheInitialized then return end
    meleeCacheInitialized = true
    task.spawn(function()
        pcall(function()
            if getgc then
                for _, gcVal in pairs(getgc(true)) do
                    if type(gcVal) == "table" then
                        if rawget(gcVal, "MeleeCooldown") or rawget(gcVal, "SwingCooldown") or rawget(gcVal, "SlashCooldown") or rawget(gcVal, "AttackCooldown") or rawget(gcVal, "HitCooldown") then
                            table.insert(cachedMeleeTables, gcVal)
                        end
                    end
                end
            end
        end)
    end)
end

local function toggleTableAttribute(attr, val)
    if getgc then
        for _, gcVal in pairs(getgc(true)) do 
            if type(gcVal) == "table" and rawget(gcVal, attr) then 
                gcVal[attr] = val 
            end 
        end 
    end
end

local function getClosest()
    local closest, dist = nil, math.huge
    for _, p in pairs(v8:GetPlayers()) do
        if p ~= v11 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local sameTeam = (v11.Team ~= nil and p.Team ~= nil and v11.Team == p.Team)
            if not sameTeam then
                local d = (v13.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d closest = p end
            end
        end
    end
    return closest
end

