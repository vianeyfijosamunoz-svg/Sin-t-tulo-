local function UpdateFOV()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = FOVRadius
    FOVCircle.Color = FOVColor
    FOVCircle.Filled = FillFOV
    FOVCircle.Transparency = 1 - (FOVTransparency / 100)
    FOVCircle.Visible = ShowFOV and AimbotEnabled

    SilentFOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    SilentFOVCircle.Radius = SilentFOVRadius
    SilentFOVCircle.Color = SilentFOVColor
    SilentFOVCircle.Filled = SilentFillFOV
    SilentFOVCircle.Transparency = 1 - (SilentFOVTransparency / 100)
    SilentFOVCircle.Visible = SilentShowFOV and getgenv().SilentAimEnabled
end

local function isTargetValid(plr)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
    local myT, thrT = LocalPlayer:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
    if myT ~= nil and thrT ~= nil then return tostring(myT) ~= tostring(thrT) end
    if LocalPlayer.Team and plr.Team then return LocalPlayer.Team ~= plr.Team end
    return true
end

local function getValidHead(char)
    local head = char:FindFirstChild("Head")
    if not head then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 1000, params)
    return (result == nil or result.Instance:IsDescendantOf(char)) and head or nil
end

local function GetClosestPlayerAimbot()
    local closest = nil
    local shortestDistance = FOVRadius
    for _, player in pairs(Players:GetPlayers()) do
        if isTargetValid(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local head = player.Character:FindFirstChild("Head") or player.Character.HumanoidRootPart
            if AimbotWallCheck then
                local valid = getValidHead(player.Character)
                if not valid then continue end
            end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
            local result = workspace:Raycast(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 1000, params)
            if result == nil or result.Instance:IsDescendantOf(player.Character) then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function GetBestSilentTarget()
    local bestPart = nil
    local shortestDist = math.huge
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetValid(plr) then
            local char = plr.Character
            if char then
                local part = char:FindFirstChild(SilentAimPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if screenDist <= SilentFOVRadius and screenDist < shortestDist then
                            if SilentWallCheck then
                                local valid = getValidHead(char)
                                if not valid then continue end
                            end
                            shortestDist = screenDist
                            bestPart = part
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

RunService.RenderStepped:Connect(function()
    UpdateFOV()
    if not getgenv().SilentAimEnabled then
        activeTargetPos = nil
        return
    end
    local bestPart = GetBestSilentTarget()
    activeTargetPos = bestPart and bestPart.Position or nil
end)

local old
old = hookmetamethod(game, "__index", newcclosure(function(self, idx)
    if getgenv().SilentAimEnabled and activeTargetPos and not checkcaller() and idx == "ViewportSize" and self == Camera then
        local pos, on = Camera:WorldToViewportPoint(activeTargetPos)
        if on then return Vector2.new(pos.X * 2, pos.Y * 2) end
    end
    return old(self, idx)
end))

